vtest "Invalid parameters"

server s1 { } -start

vinyl v1 -vcl+backend { } -start

vinyl v1 -errvcl "dynamic.director(): port may not be empty" {
	import dynamic;
	backend proforma none;
	sub vcl_init {
		new d1 = dynamic.director(port = "");
	}
}

vinyl v1 -errvcl "dynamic.director(): ttl may not be 0s" {
	import dynamic;
	backend proforma none;
	sub vcl_init {
		new d1 = dynamic.director(ttl = 0s);
	}
}

vinyl v1 -errvcl "dynamic.director(): domain_usage_timeout may not be 0s" {
	import dynamic;
	backend proforma none;
	sub vcl_init {
		new d1 = dynamic.director(domain_usage_timeout = 0s);
	}
}

vinyl v1 -errvcl "dynamic.director(): first_lookup_timeout may not be 0s" {
	import dynamic;
	backend proforma none;
	sub vcl_init {
		new d1 = dynamic.director(first_lookup_timeout = 0s);
	}
}
